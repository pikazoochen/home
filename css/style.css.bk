/* ==========================================================
       2026 火土相生配色變數 - 基於您的原始 Style.css 結構改寫
       ========================================================== */
    :root {
      /* 土 (比劫) - 穩固根基 */
      --bg-warm-white: #FAF9F6;  /* 主背景：取代 #fff */
      --bg-almond: #F5F1E8;      /* 區塊/商店背景：取代 #f8f8f8 */
      
      /* 火 (印星) - 提升名氣、流量、貴人 */
      --color-fire-red: #D65A31; /* 主強調色：取代 #74957A (綠) 與 #949494 (灰) */
      --color-fire-hover: #C04000;
      
      /* 土/火 (文字) - 取代純黑 #000 與深灰 #292929 */
      --text-coffee: #4A3B32;    /* 標題與 Logo */
      --text-warm-grey: #5D524A; /* 內文 */
      
      /* 金 (點綴) - 質感與才華 */
      --color-gold: #D4AF37;     /* 小裝飾線：取代 #AEAEAE */
    }

    /* ------------------------------------------------------------
       以下為您的原始 CSS 內容，僅將色票替換為上述變數
    ------------------------------------------------------------ */
    body {
      margin: 0;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      background: var(--bg-warm-white); /* 改為暖雲白 */
      color: var(--text-warm-grey);     /* 改為暖深灰 */
      line-height: 1.6;
    }

    a { text-decoration: none; }

    /* Navbar */
    #navbar {
      position: fixed;
      top: 0;
      width: 100%;
      background: var(--bg-warm-white); /* 暖白 */
      box-shadow: 0 2px 6px rgba(74, 59, 50, 0.1);
      z-index: 1000;
    }

    .site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      height: 84px;
      margin: auto;
    }

    #logo a {
      letter-spacing: 4px;
      font-weight: 400;
      font-size: 22px;
      color: var(--text-coffee); /* 改為深咖啡 */
      padding-left: 32px;
    }
    
    /* 增加一個小亮點在 Logo 後方，象徵火能量點睛 */
    #logo a::after {
      content: '.';
      color: var(--color-fire-red);
    }

    #nav-links a {
      color: var(--text-coffee);
      font-weight: 400;
      letter-spacing: 3px;
      font-size: 16px;
      padding: 33px 24px;
      transition: all 0.3s;
    }

    /* Hover 狀態：從灰色改為陶土紅 */
    #nav-links a:hover {
      background-color: var(--color-fire-red);
      color: #ffffff;
    }

    #nav-links li.bg_gray, 
    #nav-links a.bg_gray {
      background-color: var(--color-fire-red);
      color: #ffffff;
    }

    #nav_language {
      padding: 32px 16px 32px 8px;
      cursor: pointer;
      color: var(--color-fire-red); /* 改為紅色強調 */
      font-weight: bold;
    }

    /* Carousel */
    .carousel {
      position: relative;
      width: 100%;
      height: 100vh;
      overflow: hidden;
      background-color: var(--bg-almond);
    }

    .carousel-slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1s ease;
      background-position: center;
      background-size: cover;
      /* 模擬圖片漸層 */
      background-image: linear-gradient(rgba(74, 59, 50, 0.1), rgba(74, 59, 50, 0.1)), url('https://via.placeholder.com/1920x1080/FAF9F6/4A3B32?text=Pikazoo+Chen+Art');
    }

    .carousel-slide.active { opacity: 1; z-index: 1; }

    .carousel-caption {
      position: absolute;
      bottom: 20%;
      left: 10%;
      color: #fff;
      text-shadow: 0 2px 15px rgba(74, 59, 50, 0.5);
      max-width: 600px;
      font-family: "Montserrat", sans-serif;
      font-weight: 700;
    }

    .carousel-caption h2 { font-size: 3rem; margin: 0 0 10px; }

    /* Portfolio Section */
    .section_title {
      display: flex;
      justify-content: center;
      margin: 80px auto 50px;
      color: var(--text-coffee);
      font-family: "Montserrat", sans-serif;
      font-size: 35px;
      font-weight: 700;
      position: relative;
    }

    .gallery li>div img {
      display: block;
      width: 100%;
      transition: all 3s ease;
      filter: sepia(20%) saturate(120%); /* 增加一點暖色濾鏡效果 */
    }

    /* 作品集 Hover：從白色改為火紅色遮罩，吸引流量 */
    .gallery li>div .workhover {
      position: absolute;
      left: 10px; top: 10px; right: 10px; bottom: 10px;
      background: rgba(214, 90, 49, 0.9); /* 陶土紅 90% 透明 */
      display: flex;
      align-items: center;
      text-align: center;
      opacity: 0;
      transition: all 0.5s ease;
    }

    .gallery li>div h3 {
      width: 100%;
      color: #ffffff; /* 遮罩內改為白色文字 */
      padding: 0 10px;
      font-size: 19px;
      font-weight: 600;
      letter-spacing: 5px;
      text-transform: uppercase;
    }

    /* 裝飾線：改為復古金 */
    .gallery li>div h3::after {
      content: "";
      width: 30px;
      height: 3px;
      margin: 20px auto 0;
      background: var(--color-gold);
      display: block;
    }

    .gallery li>div p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 12px;
      letter-spacing: 2px;
      margin-top: 15px;
    }

    .gallery li>div a.open-post {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 5px;
      padding: 10px 15px;
      color: #ffffff;
      border: 2px solid #ffffff;
      transition: all 0.3s;
    }

    .gallery li>div a.open-post:hover {
      background: #ffffff;
      color: var(--color-fire-red);
    }

    /* About & Contact */
    #about, #contact {
      max-width: 800px;
      margin: 80px auto;
      padding: 0 20px;
    }

    .contact_info a {
      color: var(--color-fire-red); /* 從綠色改為紅色 */
      border-bottom: 1px dashed var(--color-fire-red);
    }

    /* 商店資訊區塊：改為杏仁米色土能量 */
    .shop_info {
      margin-top: 40px;
      padding: 30px;
      background-color: var(--bg-almond);
      border-radius: 12px;
      border-left: 6px solid var(--color-fire-red);
    }

    .shop_info h3 { color: var(--text-coffee); }
    .shop_info a { color: var(--color-fire-red); font-weight: bold; }

    #site-footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 50px 0;
      background-color: var(--text-coffee); /* 改為深咖啡色 */
      color: var(--bg-almond);
    }

    /* 您的原始 Grid 邏輯保持不變 */
    .gallery { list-style: none; display: flex; flex-wrap: wrap; }
    .gallery li { width: 25%; position: relative; overflow: hidden; aspect-ratio: 1/1; }
    @media (max-width: 1024px) { .gallery li { width: 50%; } }
    @media (max-width: 500px) { .gallery li { width: 100%; } }